build/
build-*/
# ...but build-aux/ is source, not output: it holds the flatpak manifests
# (the directory name is GNOME Builder's convention). Without this the
# pattern above swallows new files there silently.
!build-aux/
compile_commands.json

# Staged from the GPMD85Emulator sources by cmake/StageGPMD85.cmake.
core/gpmd85-generated/

# GPMD85Emulator and fujinet-firmware, cloned at their pinned commits by
# cmake/Dependencies.cmake when GPMD85_SRC / FUJINET_SRC are not set.
third_party/gpmd85/
third_party/fujinet-firmware/

# Generated by tools/fujinet/build-fujinet-desktop.sh.
tools/fujinet/work/

# flatpak-builder's state directory.
.flatpak-builder/
build-flatpak*/
repo/
